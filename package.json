{
  "name": "digital-ai-partner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A persistent business partner built on Hermes with portable business state",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env business/server.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:credentials": ".venv\\Scripts\\python.exe -m unittest discover -s tests -p test_*.py",
    "benchmark:conversation": "node --env-file-if-exists=.env scripts/conversation-benchmark.mjs",
    "benchmark:situation-router": "node --env-file-if-exists=.env scripts/situation-router-benchmark.mjs",
    "benchmark:situation-router:control": "node --env-file-if-exists=.env scripts/situation-router-benchmark.mjs --manifest benchmarks/situation-router/control-v1.json",
    "setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup.ps1",
    "build": "node scripts/build.mjs",
    "export": "node --env-file-if-exists=.env scripts/export.mjs",
    "import": "node --env-file-if-exists=.env scripts/import.mjs",
    "mcp": ".venv\\Scripts\\python.exe adapters/mcp/server.py"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "telegram": "2.26.22"
  }
}
