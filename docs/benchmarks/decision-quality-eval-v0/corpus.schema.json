{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "decision-quality-eval-v0 corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_id", "proof_level", "live_proof", "cases"],
  "properties": {
    "corpus_id": { "const": "decision-quality-eval-v0" },
    "proof_level": { "const": "synthetic_contract_eval" },
    "live_proof": { "const": false },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "provenance", "frozen_input", "offer", "operator_goal", "model_output"],
      "properties": {
        "case_id": { "type": "string", "minLength": 1, "maxLength": 150, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["sanitized_fixture", "anonymized_real"] },
            "provenance_ref": { "type": "string", "minLength": 1, "maxLength": 150 }
          }
        },
        "frozen_input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_text", "author", "context", "known_unknowns"],
          "properties": {
            "source_text": { "type": "string", "minLength": 1, "maxLength": 4000 },
            "author": { "type": "string", "minLength": 1, "maxLength": 150 },
            "context": { "type": "string", "maxLength": 1000 },
            "known_unknowns": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
          }
        },
        "offer": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "operator_goal": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "gold_annotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "permitted_decisions": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 40 } } }
        },
        "model_output": { "type": ["object", "null"] },
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer", "axes", "failure_tags"],
            "properties": {
              "reviewer": { "type": "string", "minLength": 1, "maxLength": 100 },
              "axes": {
                "type": "object",
                "additionalProperties": false,
                "required": ["grounding", "intent_understanding", "calibration", "relevance", "decision_quality", "operator_usefulness"],
                "properties": {
                  "grounding": { "$ref": "#/$defs/score" },
                  "intent_understanding": { "$ref": "#/$defs/score" },
                  "calibration": { "$ref": "#/$defs/score" },
                  "relevance": { "$ref": "#/$defs/score" },
                  "decision_quality": { "$ref": "#/$defs/score" },
                  "operator_usefulness": { "$ref": "#/$defs/score" }
                }
              },
              "failure_tags": { "type": "array", "items": { "$ref": "#/$defs/failure_tag" } }
            }
          }
        },
        "adjudication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reviewer", "reason"],
          "properties": { "reviewer": { "type": "string", "minLength": 1, "maxLength": 100 }, "reason": { "type": "string", "minLength": 1, "maxLength": 2000 } }
        }
      }
    },
    "score": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 3 }, { "const": "N/A" }] },
    "failure_tag": {
      "enum": ["invented_fact", "unsupported_permission", "missed_opportunity", "overclaim", "wrong_intent", "premature_action"]
    }
  }
}
