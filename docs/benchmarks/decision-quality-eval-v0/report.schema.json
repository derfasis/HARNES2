{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "decision-quality-eval-v0 report",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpus_id", "proof_level", "live_proof", "model", "scored_cases", "axis_summary", "failed_cases"],
  "properties": {
    "corpus_id": { "const": "decision-quality-eval-v0" },
    "proof_level": { "const": "synthetic_contract_eval" },
    "live_proof": { "const": false },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "prompt_id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "prompt_id": { "type": "string", "minLength": 1 }
      }
    },
    "scored_cases": { "type": "integer", "minimum": 0 },
    "not_applicable_cases": { "type": "integer", "minimum": 0 },
    "axis_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grounding", "intent_understanding", "calibration", "relevance", "decision_quality", "operator_usefulness"],
      "properties": {
        "grounding": { "$ref": "#/$defs/axis" },
        "intent_understanding": { "$ref": "#/$defs/axis" },
        "calibration": { "$ref": "#/$defs/axis" },
        "relevance": { "$ref": "#/$defs/axis" },
        "decision_quality": { "$ref": "#/$defs/axis" },
        "operator_usefulness": { "$ref": "#/$defs/axis" }
      }
    },
    "failed_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "axis", "score", "failure_tags"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "axis": { "type": "string", "minLength": 1 },
          "score": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 3 }, { "const": "N/A" }] },
          "failure_tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scored", "na", "mean"],
      "properties": {
        "scored": { "type": "integer", "minimum": 0 },
        "na": { "type": "integer", "minimum": 0 },
        "mean": { "type": ["number", "null"] }
      }
    }
  }
}
