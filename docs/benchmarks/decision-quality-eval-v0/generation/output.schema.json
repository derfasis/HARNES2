{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "decision-quality-eval model output",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis", "next_action", "authority"],
  "properties": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence", "contradictions", "unknowns"],
      "properties": {
        "text": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 },
        "evidence": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/span" } },
        "contradictions": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/span" } },
        "unknowns": { "type": "array", "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "situation_id", "decision", "confidence", "strategy", "reason",
        "evidence_message_ids", "unknowns", "risk_flags", "draft", "review", "reevaluate_after"],
      "properties": {
        "schema_version": { "const": 1 },
        "situation_id": { "type": "string", "minLength": 1, "maxLength": 150 },
        "decision": { "enum": ["IGNORE", "WAIT", "PUBLIC_REPLY", "DM", "HANDOFF"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "strategy": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "evidence_message_ids": { "type": "array", "minItems": 0, "maxItems": 100,
          "items": { "type": "string", "minLength": 1, "maxLength": 150 } },
        "unknowns": { "type": "array", "maxItems": 20,
          "items": { "type": "string", "maxLength": 500 } },
        "risk_flags": { "type": "array", "maxItems": 20,
          "items": { "type": "string", "maxLength": 200 } },
        "draft": { "anyOf": [{ "$ref": "#/$defs/draft" }, { "type": "null" }] },
        "review": { "type": "object", "additionalProperties": false,
          "required": ["required", "status", "authorization"],
          "properties": { "required": { "const": true }, "status": { "const": "pending" },
            "authorization": { "const": "none" } } },
        "reevaluate_after": { "type": ["string", "null"], "maxLength": 40 }
      }
    },
    "authority": { "type": "object", "additionalProperties": false,
      "required": ["contact_permission", "allowed_effects"],
      "properties": { "contact_permission": { "const": false }, "allowed_effects": { "const": [] } } }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_event_id", "author_id", "version", "text", "kind", "attribution"],
      "properties": {
        "source_event_id": { "type": "string", "minLength": 1, "maxLength": 150 },
        "author_id": { "type": "string", "minLength": 1, "maxLength": 150 },
        "version": { "type": "integer", "minimum": 1 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "kind": { "enum": ["need", "question", "intent", "refusal", "resolution", "quote", "offer",
          "vulnerability", "uncertain"] },
        "attribution": { "enum": ["author_statement", "quoted", "uncertain"] }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "action", "target_id", "text", "source_message_ids"],
      "properties": {
        "channel": { "enum": ["public", "dm"] },
        "action": { "enum": ["reply", "clarify", "propose_call"] },
        "target_id": { "type": "string", "minLength": 1, "maxLength": 150 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "source_message_ids": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 150 } }
      }
    }
  }
}
