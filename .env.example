# Copy to .env. Values are read only by the local services, never by the browser.
# Configure provider, model and URL in config/local.json as shown in README.md.
PARTNER_MODEL_API_KEY=
# Optional same-provider failover keys; used in order after classified credential failures.
PARTNER_MODEL_API_KEY_SECONDARY=
PARTNER_MODEL_API_KEY_TERTIARY=
PARTNER_TELEGRAM_BOT_TOKEN=
PARTNER_TELEGRAM_API_ID=
PARTNER_TELEGRAM_API_HASH=
# GramJS StringSession. Keep this outside tracked files; a session file path is also supported.
PARTNER_TELEGRAM_SESSION=
PARTNER_TELEGRAM_SESSION_FILE=
