          "thread_id": null,
          "reply_to_id": "1003",
          "version": 1,
          "operation": "upsert",
          "text": "Конкретні регіони ще обговорюємо. Це пошук збутових партнерів для виробництва.",
          "created_at": "2026-10-09T00:06:04.000Z",
