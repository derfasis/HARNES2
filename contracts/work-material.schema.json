{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ready material proposal; no execution authority",
  "type": "object", "additionalProperties": false,
  "required": ["title", "content", "evidence_event_ids"],
  "properties": {
    "title": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "content": {"type": "string", "minLength": 1, "maxLength": 32000, "pattern": "\\S"},
    "evidence_event_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[1-9][0-9]*$"}}
  }
}
