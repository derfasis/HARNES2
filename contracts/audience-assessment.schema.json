{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false, "required": ["needs"],
  "$defs": {
    "text": {"type":"string","minLength":1,"maxLength":2000,"pattern":"\\S"},
    "refs": {"type":"array","maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[1-9][0-9]*$","maxLength":20}},
    "ids": {"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":36}}
  },
  "properties": {
    "decision_review": {"type":"object","additionalProperties":false,
      "required":["version","scope","disposition","summary","unknowns","exchange_reviews"],
      "properties":{
        "version":{"const":1},"scope":{"const":"supplied_packet_only"},
        "disposition":{"enum":["needs_proposed","no_need_proposed"]},
        "summary":{"type":"string","minLength":1,"maxLength":1000,"pattern":"\\S"},
        "unknowns":{"type":"array","minItems":1,"maxItems":8,"items":{"type":"string","minLength":1,"maxLength":1000,"pattern":"\\S"}},
        "exchange_reviews":{"type":"array","minItems":1,"maxItems":8,"items":{
          "type":"object","additionalProperties":false,
          "required":["exchange_id","judgment","reason","evidence_event_ids","support_quotes"],
          "properties":{
            "exchange_id":{"type":"string","minLength":1,"maxLength":36},
            "judgment":{"enum":["relevant","no_proposal","uncertain"]},
            "reason":{"type":"string","minLength":1,"maxLength":1000,"pattern":"\\S"},
            "evidence_event_ids":{"type":"array","$ref":"#/$defs/refs","minItems":1},
            "support_quotes":{"type":"array","minItems":1,"maxItems":32,"items":{
              "type":"object","additionalProperties":false,"required":["source_event_id","quote"],
              "properties":{"source_event_id":{"type":"string","pattern":"^[1-9][0-9]*$","maxLength":20},"quote":{"$ref":"#/$defs/text"}}
            }}
          }
        }}
      }
    },
    "needs": {"type":"array","maxItems":8,"items":{
      "type":"object","additionalProperties":false,
      "required":["need_id","title","hypothesis","why_now","exchange_ids","evidence_event_ids","counterevidence_event_ids","support_quotes","next_step","reason","unknowns"],
      "properties":{
        "proposal_version":{"const":2},
        "first_contact":{"type":"object","additionalProperties":false,
          "required":["version","target_event_id","target_quote","channel","help","channel_reason"],
          "properties":{
            "version":{"const":1},
            "target_event_id":{"type":"string","pattern":"^[1-9][0-9]*$","maxLength":20},
            "target_quote":{"$ref":"#/$defs/text"},
            "channel":{"enum":["public_reply","none"]},
            "help":{"$ref":"#/$defs/text"},
            "channel_reason":{"$ref":"#/$defs/text"}
          }
        },
        "need_id":{"type":["string","null"],"minLength":1,"maxLength":36},
        "title":{"type":"string","minLength":1,"maxLength":200,"pattern":"\\S"},
        "hypothesis":{"$ref":"#/$defs/text"},"why_now":{"$ref":"#/$defs/text"},
        "exchange_ids":{"$ref":"#/$defs/ids"},
        "evidence_event_ids":{"type":"array","$ref":"#/$defs/refs","minItems":1},
        "counterevidence_event_ids":{"$ref":"#/$defs/refs"},
        "context_event_ids":{"$ref":"#/$defs/refs"},
        "context_review":{"type":"array","minItems":1,"maxItems":8,"items":{
          "type":"object","additionalProperties":false,
          "required":["exchange_id","classification","evidence_event_ids","reason"],
          "properties":{
            "exchange_id":{"type":"string","minLength":1,"maxLength":36},
            "classification":{"enum":["supporting","related","counterevidence","uncertain","unrelated"]},
            "evidence_event_ids":{"type":"array","$ref":"#/$defs/refs","minItems":1},
            "reason":{"$ref":"#/$defs/text"}
          }
        }},
        "material_preview":{"type":"object","additionalProperties":false,
          "required":["title","content","evidence_event_ids"],"properties":{
            "title":{"type":"string","minLength":1,"maxLength":200,"pattern":"\\S"},
            "content":{"type":"string","minLength":1,"maxLength":8000,"pattern":"\\S"},
            "evidence_event_ids":{"type":"array","$ref":"#/$defs/refs","minItems":1}
          }
        },
        "support_quotes":{"type":"array","minItems":1,"maxItems":32,"items":{
          "type":"object","additionalProperties":false,"required":["source_event_id","quote"],"properties":{
            "source_event_id":{"type":"string","pattern":"^[1-9][0-9]*$","maxLength":20},
            "quote":{"$ref":"#/$defs/text"}
          }
        }},
        "next_step":{"enum":["observe","research","prepare_material"]},
        "reason":{"$ref":"#/$defs/text"},
        "unknowns":{"type":"array","minItems":1,"maxItems":8,"items":{"$ref":"#/$defs/text"}}
      },
      "dependencies":{
        "context_event_ids":["proposal_version"],"context_review":["proposal_version"],"material_preview":["proposal_version"],
        "first_contact":["proposal_version"],
        "proposal_version":["context_event_ids","context_review"]
      },
      "allOf":[{
        "if":{"required":["proposal_version"],"properties":{"proposal_version":{"const":2},"next_step":{"const":"prepare_material"}}},
        "then":{"properties":{"material_preview":{}},"required":["material_preview"]}
      }]
    }}
  }
}
