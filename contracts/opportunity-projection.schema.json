{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harnes.local/contracts/opportunity-projection.schema.json",
  "title": "Opportunity Projection v0: read-only typed Router extension",
  "$defs": {
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "author_id", "version", "text", "created_at", "reply_to_id", "thread_id"],
      "properties": {
        "id": { "$ref": "situation-router.schema.json#/$defs/id" },
        "author_id": { "$ref": "situation-router.schema.json#/$defs/id" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "text": { "type": "string", "minLength": 1, "maxLength": 16000 },
        "created_at": { "$ref": "situation-router.schema.json#/$defs/timestamp" },
        "reply_to_id": { "anyOf": [{ "$ref": "situation-router.schema.json#/$defs/id" }, { "type": "null" }] },
        "thread_id": { "anyOf": [{ "$ref": "situation-router.schema.json#/$defs/id" }, { "type": "null" }] }
      }
    },
    "offer": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "text", "criteria", "exclusions"],
      "properties": {
        "id": { "$ref": "situation-router.schema.json#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "criteria": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "exclusions": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["situation_id", "source", "anchor_message_id", "messages", "active_offer"],
      "properties": {
        "situation_id": { "$ref": "situation-router.schema.json#/$defs/id" },
        "source": { "$ref": "situation-router.schema.json#/$defs/input/properties/source" },
        "anchor_message_id": { "$ref": "situation-router.schema.json#/$defs/id" },
        "messages": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "$ref": "#/$defs/message" } },
        "active_offer": { "$ref": "#/$defs/offer" }
      }
    },
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["message_id", "author_id", "version", "span", "kind", "attribution"],
      "properties": {
        "message_id": { "$ref": "situation-router.schema.json#/$defs/id" },
        "author_id": { "$ref": "situation-router.schema.json#/$defs/id" },
        "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "span": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "kind": { "enum": ["need", "question", "intent", "refusal", "resolution", "quote", "offer", "vulnerability", "uncertain"] },
        "attribution": { "enum": ["author_statement", "quoted", "uncertain"] }
      }
    },
    "opportunity": {
      "type": "object", "additionalProperties": false,
      "required": ["hypothesis", "evidence", "contradictions", "unknowns"],
      "properties": {
        "hypothesis": { "type": ["string", "null"], "minLength": 1, "maxLength": 2000 },
        "evidence": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/span" } },
        "contradictions": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/span" } },
        "unknowns": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["contact_permission", "allowed_effects"],
      "properties": { "contact_permission": { "const": false }, "allowed_effects": { "const": [] } }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version", "situation_id", "opportunity", "next_action", "authority"],
      "properties": {
        "contract_version": { "const": "opportunity-projection-v0" },
        "situation_id": { "$ref": "situation-router.schema.json#/$defs/id" },
        "opportunity": { "$ref": "#/$defs/opportunity" },
        "next_action": { "$ref": "situation-router.schema.json#/$defs/output" },
        "authority": { "$ref": "#/$defs/authority" }
      }
    }
  }
}
