{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Focused audience model request v1",
  "type": "object", "additionalProperties": false,
  "required": ["version", "model_requested", "need_id", "need_revision", "need_basis_fingerprint", "context_fingerprint", "observation_heads"],
  "properties": {
    "version": {"const": 1}, "model_requested": {"const": true},
    "need_id": {"type": "string", "minLength": 1, "maxLength": 36},
    "need_revision": {"type": "integer", "minimum": 1},
    "need_basis_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retry_of": {"type": "object", "additionalProperties": false,
      "required": ["assessment_id", "basis_fingerprint"],
      "properties": {
        "assessment_id": {"type": "string", "minLength": 1, "maxLength": 36},
        "basis_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }},
    "observation_heads": {"type": "array", "minItems": 1, "maxItems": 100,
      "items": {"type": "array", "minItems": 2, "maxItems": 2,
        "items": [{"type": "string", "minLength": 1}, {"type": "integer", "minimum": 0}], "additionalItems": false}}
  }
}
