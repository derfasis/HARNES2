[
  {
    "name": "partner_get_context",
    "description": "Read current scoped partner/person context, owner requirements, policy and a research-reference catalogue. These are not automatically verified facts or personal/market terms. Country-specific material requires a separately reviewed reference for this question. Other people's conversations are excluded in a conversation run. Call with exactly {}.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "partner_list_work",
    "description": "Read existing tasks in this run's scope. Do not duplicate them. Call with exactly {}.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "partner_search_experience",
    "description": "Search owner-reviewed lessons. Private lessons from other conversations are excluded.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_propose_draft",
    "conversationOnly": true,
    "description": "Queue a proposed message for the current person. Does not approve or send. Use this tool for addressed messages; final prose is only an internal note.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "action": {
          "enum": [
            "reply",
            "clarify",
            "propose_call",
            "handoff"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "text",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_propose_fact",
    "conversationOnly": true,
    "description": "Propose a sourced fact about the current person for review. This does not confirm the fact.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 4000
        },
        "source_message_id": {
          "type": "string"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "text",
        "source_ref"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_propose_task",
    "description": "Schedule a future task with purpose and evidence. Your own general research, planning or review task (no conversation) goes straight to work, a few per day, within the owner's run limits; beyond that it waits for the owner. A task inside a conversation always waits for the owner's review, and a follow-up requires a conversation and source of agreement.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "reply",
            "follow_up",
            "research",
            "planning",
            "review"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "instructions": {
          "type": "string",
          "maxLength": 6000
        },
        "due_at": {
          "type": "string",
          "description": "ISO timestamp with explicit timezone"
        },
        "evidence": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "kind",
        "title",
        "instructions",
        "due_at"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_propose_lesson",
    "description": "Store a candidate lesson with evidence and applicability. It cannot become active without owner review.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "maxLength": 8000
        },
        "applicability": {
          "type": "string",
          "maxLength": 2000
        },
        "evidence": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "title",
        "text",
        "applicability",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_propose_capability",
    "description": "Record a missing capability and optional SKILL.md proposal. Does not install code, grant rights or change active skills.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "purpose": {
          "type": "string",
          "maxLength": 4000
        },
        "permissions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "acceptance": {
          "type": "string",
          "maxLength": 4000
        },
        "skill_content": {
          "type": "string",
          "maxLength": 30000
        }
      },
      "required": [
        "name",
        "purpose",
        "permissions",
        "acceptance"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_record_belief",
    "conversationOnly": true,
    "engagementOnly": true,
    "description": "Record an exact attributed CLAIM or an evidence-backed HYPOTHESIS. Neither grants permission. Call before committing the decision.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "engagement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "CLAIM",
            "HYPOTHESIS"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "message",
                  "fact",
                  "outcome",
                  "reference"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "counterevidence": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "message",
                  "fact",
                  "outcome",
                  "reference"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "supersedes_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expires_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        }
      },
      "required": [
        "engagement_id",
        "expected_revision",
        "kind",
        "text",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_commit_decision",
    "conversationOnly": true,
    "engagementOnly": true,
    "description": "Commit exactly one scoped durable decision. ACT requires action and forbids wait_for/wake_at. WAIT requires wait_for and/or wake_at and forbids action. IGNORE/HANDOFF/STOP forbid action/wait_for/wake_at. Omit optional objects instead of adding placeholder keys. ACT is a draft, never a send; HANDOFF transfers responsibility; STOP suppresses contact.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "engagement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "ACT",
            "WAIT",
            "IGNORE",
            "HANDOFF",
            "STOP"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "expected_next": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "message",
                  "fact",
                  "outcome",
                  "reference"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "wait_for": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "inbound",
              "operator_response",
              "permission_changed",
              "commitment_due",
              "outcome"
            ]
          }
        },
        "wake_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "action": {
          "type": "object",
          "properties": {
            "purpose": {
              "enum": [
                "reply",
                "follow_up"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "explained": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "commitments": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "owner": {
                    "enum": [
                      "AI",
                      "HUMAN"
                    ]
                  },
                  "due_at": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  }
                },
                "required": [
                  "text",
                  "owner"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "purpose",
            "text"
          ],
          "additionalProperties": false
        },
        "state": {
          "type": "object",
          "properties": {
            "current_need": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "unknowns": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "engagement_id",
        "expected_revision",
        "kind",
        "reason",
        "expected_next",
        "evidence"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_propose_episode_lesson",
    "conversationOnly": true,
    "engagementOnly": true,
    "description": "Propose a local candidate lesson only from explicitly linked observed outcomes. Does not activate strategy or grant permissions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "engagement_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "applicability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "outcome_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "required": [
        "engagement_id",
        "expected_revision",
        "title",
        "text",
        "applicability",
        "outcome_ids"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_notebook_expect",
    "generalOnly": true,
    "description": "Before a move of your own, write in your journal what you are about to do, what you expect to happen and when you will check. No approval is needed, and the check time wakes you by itself: do not propose a separate task for it. A move that matches your stop-list is refused.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "move": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "expectation": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "basis": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "check_at": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "ISO timestamp with explicit timezone, in the future (at most 90 days)"
        }
      },
      "required": [
        "title",
        "move",
        "expectation",
        "check_at"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_notebook_result",
    "generalOnly": true,
    "description": "Record what actually happened for a journal entry, in a later run than the one that opened it: an outcome comes from outside and cannot exist yet in the same run. verdict: matched, missed or unknown. If it is not known yet, pass verdict unknown with recheck_at to look again later (at most 3 times). A missed expectation is the moment to change a rule or add a stop yourself.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^J-[0-9]{4,6}$"
        },
        "result": {
          "type": "string",
          "minLength": 3,
          "maxLength": 800
        },
        "verdict": {
          "type": "string",
          "enum": [
            "matched",
            "missed",
            "unknown"
          ]
        },
        "lesson": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "recheck_at": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "ISO timestamp with explicit timezone; only with verdict unknown"
        }
      },
      "required": [
        "entry_id",
        "result",
        "verdict"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_notebook_rule",
    "generalOnly": true,
    "description": "Write or change one of your own working rules. add: title, text, applies_to, optional evidence (journal J-…, reading L-… or owner note N-… ids). confirm: rule_id plus a new closed journal entry in evidence. revise: rule_id, the changed fields and a reason. retire: rule_id and a reason. One observation makes a hypothesis; two journal entries closed with a real outcome (matched or missed) make it confirmed. Rules are about methods, never about a named person.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add",
            "revise",
            "confirm",
            "retire"
          ]
        },
        "rule_id": {
          "type": "string",
          "pattern": "^R-[0-9]{4,6}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "applies_to": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "evidence": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^[JLN]-[0-9]{4,6}$"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_notebook_never",
    "generalOnly": true,
    "description": "Your stop-list: a move or wording you will not repeat. add: title, reason and 1-5 short literal signs (phrases or venue names); code then refuses your later drafts, tasks and planned moves that contain a sign. retire: stop_id and a reason, to lift your own stop when your experience changed. Stops set by the owner cannot be lifted by you.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add",
            "retire"
          ]
        },
        "stop_id": {
          "type": "string",
          "pattern": "^S-[0-9]{4,6}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          }
        },
        "applies_to": {
          "type": "string",
          "enum": [
            "move",
            "message",
            "any"
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^[JLN]-[0-9]{4,6}$"
          }
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_notebook_note",
    "generalOnly": true,
    "description": "Keep what you read or were advised (a book, a forum, another AI) as untested material with its source. add: title, source, text, optional to_test. tried: note_id and the journal_id where you tried it. discard: note_id and a reason. A reading is not your rule until you have tried it yourself.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add",
            "tried",
            "discard"
          ]
        },
        "note_id": {
          "type": "string",
          "pattern": "^L-[0-9]{4,6}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "source": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "text": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1200
        },
        "to_test": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "journal_id": {
          "type": "string",
          "pattern": "^J-[0-9]{4,6}$"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        }
      },
      "required": [
        "op"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "partner_notebook_answer",
    "generalOnly": true,
    "description": "Answer an owner's objection written in your notebook. stance: agree, partly or disagree, with your reasoning. Disagreeing is allowed: then keep your rule and say why.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "note_id": {
          "type": "string",
          "pattern": "^N-[0-9]{4,6}$"
        },
        "stance": {
          "type": "string",
          "enum": [
            "agree",
            "partly",
            "disagree"
          ]
        },
        "answer": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        }
      },
      "required": [
        "note_id",
        "stance",
        "answer"
      ],
      "additionalProperties": false
    }
  }
]
