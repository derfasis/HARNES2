{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["summary", "claims", "hypotheses", "unknowns", "next"],
  "$defs": {
    "text": {"type":"string","minLength":1,"maxLength":2000,"pattern":"\\S"},
    "refs": {"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[1-9][0-9]*$","maxLength":20}},
    "supported": {"type":"object","additionalProperties":false,"required":["text","evidence_event_ids"],"properties":{
      "text":{"$ref":"#/$defs/text"},"evidence_event_ids":{"type":"array","$ref":"#/$defs/refs","minItems":1}}}
  },
  "properties": {
    "summary":{"$ref":"#/$defs/supported"},
    "claims":{"type":"array","maxItems":12,"items":{"type":"object","additionalProperties":false,
      "required":["source_event_id","quote"],"properties":{"source_event_id":{"type":"string","pattern":"^[1-9][0-9]*$","maxLength":20},"quote":{"$ref":"#/$defs/text"}}}},
    "hypotheses":{"type":"array","maxItems":12,"items":{"type":"object","additionalProperties":false,
      "required":["text","evidence_event_ids","counterevidence_event_ids"],"properties":{"text":{"$ref":"#/$defs/text"},
        "evidence_event_ids":{"type":"array","$ref":"#/$defs/refs","minItems":1},"counterevidence_event_ids":{"$ref":"#/$defs/refs"}}}},
    "unknowns":{"type":"array","minItems":1,"maxItems":12,"items":{"$ref":"#/$defs/text"}},
    "next":{"type":"object","additionalProperties":false,"required":["kind","reason","wake_at","owner_question"],
      "properties":{"kind":{"enum":["observe","ask_owner","close"]},"reason":{"$ref":"#/$defs/text"},
        "wake_at":{"type":["string","null"],"maxLength":40},"owner_question":{"type":["string","null"],"minLength":1,"maxLength":2000}}}
  }
}
