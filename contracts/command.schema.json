{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operator command envelope v1",
  "type": "object",
  "required": ["request_id", "action", "payload"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string", "minLength": 1, "maxLength": 150 },
    "action": { "type": "string", "minLength": 1, "maxLength": 80 },
    "payload": { "type": "object" }
  }
}
