{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["source_id", "checkpoint_fingerprint", "acknowledge_gap", "expires_at", "reason"],
  "properties": {
    "source_id": {"type": "string", "pattern": "^telegram:channel:[1-9][0-9]{0,18}$"},
    "checkpoint_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "acknowledge_gap": {"const": true},
    "expires_at": {"type": "string", "minLength": 20, "maxLength": 30},
    "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
