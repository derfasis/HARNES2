{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "decision-quality-eval-v0 report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "corpus_id",
    "proof_level",
    "live_proof",
    "model",
    "scored_cases",
    "axis_summary",
    "case_results",
    "failed_cases"
  ],
  "properties": {
    "corpus_id": {
      "const": "decision-quality-eval-v0"
    },
    "proof_level": {
      "enum": [
        "offline_human_eval"
      ]
    },
    "live_proof": {
      "const": false
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "prompt_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "scored_cases": {
      "type": "integer",
      "minimum": 0
    },
    "not_applicable_cases": {
      "type": "integer",
      "minimum": 0
    },
    "case_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case_result"
      }
    },
    "axis_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grounding",
        "intent_understanding",
        "calibration",
        "relevance",
        "decision_quality",
        "operator_usefulness"
      ],
      "properties": {
        "grounding": {
          "$ref": "#/$defs/axis"
        },
        "intent_understanding": {
          "$ref": "#/$defs/axis"
        },
        "calibration": {
          "$ref": "#/$defs/axis"
        },
        "relevance": {
          "$ref": "#/$defs/axis"
        },
        "decision_quality": {
          "$ref": "#/$defs/axis"
        },
        "operator_usefulness": {
          "$ref": "#/$defs/axis"
        }
      }
    },
    "failed_cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/failed_case"
      }
    }
  },
  "$defs": {
    "score": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        {
          "const": "N/A"
        }
      ]
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grounding",
        "intent_understanding",
        "calibration",
        "relevance",
        "decision_quality",
        "operator_usefulness"
      ],
      "properties": {
        "grounding": {
          "$ref": "#/$defs/score"
        },
        "intent_understanding": {
          "$ref": "#/$defs/score"
        },
        "calibration": {
          "$ref": "#/$defs/score"
        },
        "relevance": {
          "$ref": "#/$defs/score"
        },
        "decision_quality": {
          "$ref": "#/$defs/score"
        },
        "operator_usefulness": {
          "$ref": "#/$defs/score"
        }
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "reviews",
        "final_axes",
        "failure_tags",
        "failed"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "reviews": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewer",
              "axes"
            ],
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "axes": {
                "$ref": "#/$defs/axes"
              },
              "failure_tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "adjudication": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reviewer",
            "final_axes",
            "reason"
          ],
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "final_axes": {
              "$ref": "#/$defs/axes"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "final_axes": {
          "$ref": "#/$defs/axes"
        },
        "failure_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failed": {
          "type": "boolean"
        }
      }
    },
    "failed_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "axis",
        "score",
        "failure_tags"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "axis": {
          "type": "string",
          "minLength": 1
        },
        "score": {
          "$ref": "#/$defs/score"
        },
        "failure_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scored",
        "na",
        "mean"
      ],
      "properties": {
        "scored": {
          "type": "integer",
          "minimum": 0
        },
        "na": {
          "type": "integer",
          "minimum": 0
        },
        "mean": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  }
}
